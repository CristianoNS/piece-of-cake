<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PieceOfCake</AssemblyName>
    <RootNamespace>PieceOfCake</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF takes its DPI mode from app.manifest; the WinForms analyzer hint does not apply here. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray-white.ico" LogicalName="tray-white.ico" />
    <EmbeddedResource Include="Assets\tray-black.ico" LogicalName="tray-black.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PieceOfCake.Tests" />
  </ItemGroup>

</Project>
