<Window x:Class="PieceOfCake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PieceOfCake.ViewModels"
        xmlns:svc="clr-namespace:PieceOfCake.Services"
        Title="Piece of Cake"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="#FF202020"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

    <!-- Wymiary jak w natywnym panelu szybkich ustawień Windows 11 (w niezależnych od DPI pikselach):
         szerokość 360, marginesy 24, kafelek 96x48, odstęp 12, rząd kafelków co 96, pasek dolny 48. -->
    <Border x:Name="RootBorder" Background="#FF202020">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ekran główny -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,24,24,0">

                    <StackPanel x:Name="HuePairPanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock Text="Połącz z mostkiem Hue" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                   Margin="0,4,0,12"
                                   Text="Wpisz adres IP mostka, kliknij „Połącz” i w ciągu 30 sekund naciśnij okrągły przycisk na mostku."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BridgeIpBox" Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"/>
                            <Button x:Name="DetectBridgeButton" Grid.Column="1" Style="{StaticResource StandardButton}"
                                    Content="Wykryj" Margin="8,0,0,0"
                                    ToolTip="Szuka mostka przez usługę discovery.meethue.com (Philips)"
                                    Click="DetectBridgeButton_Click"/>
                            <Button x:Name="PairButton" Grid.Column="2" Style="{StaticResource AccentButton}"
                                    Content="Połącz" Margin="8,0,0,0" Click="PairButton_Click"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="HueStatusText" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,16"/>

                    <!-- Kafelki: pokoje Hue, własne skrypty, akcje -->
                    <ItemsControl x:Name="TilesControl" Margin="-6,0,-6,-2" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>

                            <DataTemplate DataType="{x:Type vm:HueRoomVm}">
                                <StackPanel Margin="6,0" Height="96">
                                    <Border x:Name="Tile" Height="48" CornerRadius="4" BorderThickness="1"
                                            Background="{DynamicResource TileOffBrush}"
                                            BorderBrush="{DynamicResource TileOffBorderBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="Face" Style="{StaticResource TileFaceLeft}" Content="&#xE82F;"
                                                    Foreground="{DynamicResource TextBrush}" Click="RoomToggle_Click"
                                                    ToolTip="Włącz lub wyłącz"/>
                                            <Rectangle x:Name="Divider" Grid.Column="1" Fill="{DynamicResource TileOffBorderBrush}"/>
                                            <Button x:Name="More" Grid.Column="2" Style="{StaticResource TileFaceRight}"
                                                    Content="&#xE76C;" Foreground="{DynamicResource TextBrush}"
                                                    Click="RoomMore_Click" ToolTip="Sceny"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TileLabel}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Divider" Property="Fill" Value="#33000000"/>
                                        <Setter TargetName="Face" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                        <Setter TargetName="More" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type svc:ScriptEntry}">
                                <StackPanel Margin="6,0" Height="96">
                                    <Button Style="{StaticResource TileButton}" Content="&#xE756;"
                                            ToolTip="{Binding Path}" Click="ScriptButton_Click"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TileLabel}"/>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:ActionTileVm}">
                                <StackPanel Margin="6,0" Height="96">
                                    <Button x:Name="Tile" Style="{StaticResource TileButton}" Content="{Binding Glyph}"
                                            IsEnabled="{Binding IsEnabled}" Click="ActionTile_Click"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TileLabel}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Tile" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                        </ItemsControl.Resources>
                    </ItemsControl>

                    <!-- Jasność wybranego pokoju -->
                    <StackPanel x:Name="HomeBrightnessPanel" Visibility="Collapsed">
                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="-24,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                   Margin="33,6,0,0" Height="16" TextTrimming="CharacterEllipsis"/>
                        <Grid Height="32" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="33"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="100"
                                    Value="{Binding Brightness, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="FooterStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Ekran scen wybranego pokoju (układ jak lista sieci Wi-Fi w panelu Windows) -->
            <Grid x:Name="ScenesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScenesBackButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            Content="&#xE72B;" Width="32" Height="32" FontSize="14" ToolTip="Wróć"
                            Click="ScenesBackButton_Click"/>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0" TextTrimming="CharacterEllipsis"/>
                    <ToggleButton Grid.Column="3" Style="{StaticResource SwitchToggle}" Margin="0,0,16,0"
                                  VerticalAlignment="Center" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  ToolTip="Włącz lub wyłącz pokój"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalAlignment="Top" MaxHeight="224" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Scenes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SceneRow}" Content="{Binding Name}"
                                        HorizontalContentAlignment="Left" Click="SceneChip_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}"/>
                    <Grid Height="32" Margin="24,22,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="33"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="100"
                                Value="{Binding Brightness, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Pasek dolny: statystyki systemu i ustawienia -->
            <Border Grid.Row="1" Height="48" Background="{DynamicResource FooterBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextBlock.FontSize="12">
                        <TextBlock Style="{StaticResource FooterIcon}" Text="&#xE950;" ToolTip="Procesor"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource FooterValue}" Text="0%"/>
                        <TextBlock Style="{StaticResource FooterIcon}" Text="&#xE964;" Margin="14,0,6,0" ToolTip="Pamięć"/>
                        <TextBlock x:Name="RamText" Style="{StaticResource FooterValue}" Text="-"/>
                        <TextBlock x:Name="NetDownIcon" Style="{StaticResource FooterIcon}" Text="&#xE896;" Margin="14,0,4,0"
                                   ToolTip="Pobieranie"/>
                        <TextBlock x:Name="NetText" Style="{StaticResource FooterValue}" Text="–"/>
                        <TextBlock x:Name="NetUpIcon" Style="{StaticResource FooterIcon}" Text="&#xE898;" Margin="10,0,4,0"
                                   ToolTip="Wysyłanie"/>
                        <TextBlock x:Name="NetUpText" Style="{StaticResource FooterValue}" Text="–"/>
                    </StackPanel>
                    <Button x:Name="SettingsFolderButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            Content="&#xE713;" Width="32" Height="32" FontSize="14" Margin="0,0,-8,0"
                            ToolTip="Otwórz folder ustawień (tu dodasz własne skrypty)"
                            Click="SettingsFolderButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
