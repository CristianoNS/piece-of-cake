<Window x:Class="PieceOfCake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piece of Cake"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="#FF202020"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

    <Border x:Name="RootBorder" Background="#FF202020">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- Procesor i pamięć -->
                <TextBlock Text="System" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Procesor"/>
                    <TextBlock x:Name="CpuText" Text="0%" HorizontalAlignment="Right"
                               Foreground="{StaticResource SubTextBrush}"/>
                </Grid>
                <ProgressBar x:Name="CpuBar" Style="{StaticResource MeterBar}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Pamięć"/>
                    <TextBlock x:Name="RamText" Text="-" HorizontalAlignment="Right"
                               Foreground="{StaticResource SubTextBrush}"/>
                </Grid>
                <ProgressBar x:Name="RamBar" Style="{StaticResource MeterBar}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="Sieć"/>
                    <TextBlock x:Name="NetText" Text="–" HorizontalAlignment="Right"
                               Foreground="{StaticResource SubTextBrush}"/>
                </Grid>

                <!-- Philips Hue -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Światła Hue" Style="{StaticResource SectionHeader}" Margin="0"
                               VerticalAlignment="Center"/>
                    <Button x:Name="HueRefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            Width="28" Height="28" FontSize="13" HorizontalAlignment="Right"
                            ToolTip="Odśwież" Click="HueRefreshButton_Click"/>
                </Grid>
                <TextBlock x:Name="HueStatusText" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"/>
                <StackPanel x:Name="HuePairPanel" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"
                               Text="Podaj adres IP mostka Hue, kliknij „Połącz” i w ciągu 30 sekund naciśnij okrągły przycisk na mostku."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BridgeIpBox" Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"/>
                        <Button x:Name="DetectBridgeButton" Grid.Column="1" Style="{StaticResource ChipButton}"
                                Content="Wykryj" Margin="6,0,0,0"
                                ToolTip="Szuka mostka przez usługę discovery.meethue.com (Philips)"
                                Click="DetectBridgeButton_Click"/>
                        <Button x:Name="PairButton" Grid.Column="2" Style="{StaticResource ChipButton}"
                                Content="Połącz" Margin="6,0,0,0" Click="PairButton_Click"/>
                    </Grid>
                </StackPanel>
                <ItemsControl x:Name="HueRoomsControl" Margin="0,0,0,8" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource TileBrush}" CornerRadius="8" Padding="12,10"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,52,0"/>
                                        <ToggleButton Style="{StaticResource SwitchToggle}"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                                    </Grid>
                                    <Slider Style="{StaticResource FlatSlider}" Minimum="1" Maximum="100"
                                            Margin="0,6,0,0" Value="{Binding Brightness, Mode=TwoWay}"/>
                                    <ItemsControl ItemsSource="{Binding Scenes}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" Content="{Binding Name}"
                                                        Padding="8,4" FontSize="12" Click="SceneChip_Click"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Skrypty -->
                <TextBlock Text="Skrypty" Style="{StaticResource SectionHeader}" Margin="0,8,0,0"/>
                <TextBlock x:Name="ScriptsHint" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                           Text="Brak skryptów. Dodaj je w pliku settings.json (przycisk z zębatką poniżej)."/>
                <ItemsControl x:Name="ScriptsControl" Margin="0,0,0,12" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Content="{Binding Name}"
                                    ToolTip="{Binding Path}" Click="ScriptButton_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Stopka -->
                <Rectangle Height="1" Fill="{StaticResource TrackBrush}" Margin="0,4,0,12"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PassportButton" Style="{StaticResource ChipButton}" Margin="0"
                            HorizontalAlignment="Left" Content="Paszport komputera"
                            Click="PassportButton_Click"/>
                    <Button x:Name="SettingsFolderButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            Content="&#xE713;" ToolTip="Otwórz folder ustawień"
                            Click="SettingsFolderButton_Click"/>
                </Grid>
                <Grid>
                    <TextBlock Text="Uruchamiaj z systemem" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="AutostartToggle" Style="{StaticResource SwitchToggle}"
                                  HorizontalAlignment="Right" Click="AutostartToggle_Click"/>
                </Grid>
                <TextBlock x:Name="FooterStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource SubTextBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
