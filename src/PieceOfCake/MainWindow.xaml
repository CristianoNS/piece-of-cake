<Window x:Class="PieceOfCake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PieceOfCake.ViewModels"
        xmlns:svc="clr-namespace:PieceOfCake.Services"
        Title="Piece of Cake"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="#FF202020"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

    <Border x:Name="RootBorder" Background="#FF202020">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ekran główny -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,20,20,8">

                    <StackPanel x:Name="HuePairPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"
                                   Text="Podaj adres IP mostka Hue, kliknij „Połącz” i w ciągu 30 sekund naciśnij okrągły przycisk na mostku."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BridgeIpBox" Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"/>
                            <Button x:Name="DetectBridgeButton" Grid.Column="1" Style="{StaticResource ChipButton}"
                                    Content="Wykryj" Margin="6,0,0,0"
                                    ToolTip="Szuka mostka przez usługę discovery.meethue.com (Philips)"
                                    Click="DetectBridgeButton_Click"/>
                            <Button x:Name="PairButton" Grid.Column="2" Style="{StaticResource ChipButton}"
                                    Content="Połącz" Margin="6,0,0,0" Click="PairButton_Click"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="HueStatusText" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,12"/>

                    <!-- Kafelki: pokoje Hue, własne skrypty, akcje -->
                    <ItemsControl x:Name="TilesControl" Margin="-4,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>

                            <DataTemplate DataType="{x:Type vm:HueRoomVm}">
                                <StackPanel Margin="4,0,4,14">
                                    <Border x:Name="Tile" Height="48" CornerRadius="4" BorderThickness="1"
                                            Background="{StaticResource TileOffBrush}"
                                            BorderBrush="{StaticResource TileOffBorderBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="Face" Style="{StaticResource TileFaceLeft}" Content="&#xE82F;"
                                                    Foreground="{StaticResource TextBrush}" Click="RoomToggle_Click"
                                                    ToolTip="Włącz lub wyłącz"/>
                                            <Rectangle x:Name="Divider" Grid.Column="1" Fill="{StaticResource TileOffBorderBrush}"/>
                                            <Button x:Name="More" Grid.Column="2" Style="{StaticResource TileFaceRight}"
                                                    Content="&#xE76C;" Foreground="{StaticResource TextBrush}"
                                                    Click="RoomMore_Click" ToolTip="Sceny"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TileLabel}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Divider" Property="Fill" Value="#33000000"/>
                                        <Setter TargetName="Face" Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                        <Setter TargetName="More" Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type svc:ScriptEntry}">
                                <StackPanel Margin="4,0,4,14">
                                    <Button Style="{StaticResource TileButton}" Content="&#xE756;"
                                            ToolTip="{Binding Path}" Click="ScriptButton_Click"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TileLabel}"/>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:ActionTileVm}">
                                <StackPanel Margin="4,0,4,14">
                                    <Button x:Name="Tile" Style="{StaticResource TileButton}" Content="{Binding Glyph}"
                                            IsEnabled="{Binding IsEnabled}" Click="ActionTile_Click"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TileLabel}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Tile" Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                        </ItemsControl.Resources>
                    </ItemsControl>

                    <!-- Jasność wybranego pokoju -->
                    <StackPanel x:Name="HomeBrightnessPanel" Visibility="Collapsed" Margin="0,4,0,8">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                   Margin="34,0,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="100"
                                    Value="{Binding Brightness, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="FooterStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,8"
                               Foreground="{StaticResource SubTextBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Ekran scen wybranego pokoju -->
            <Grid x:Name="ScenesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="12,12,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScenesBackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            ToolTip="Wróć" Click="ScenesBackButton_Click"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"
                               Text="Wyłączone">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter Property="Text" Value="Włączone"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Scenes}" Margin="12,0,12,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SceneRow}" Content="{Binding Name}"
                                        HorizontalContentAlignment="Left" Click="SceneChip_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="20,8,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="100"
                            Value="{Binding Brightness, Mode=TwoWay}"/>
                </Grid>
            </Grid>

            <!-- Pasek dolny: statystyki systemu i ustawienia -->
            <Border Grid.Row="1" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="14" ToolTip="Procesor"/>
                        <Run x:Name="CpuText" Text="0%"/>
                        <Run Text="   "/>
                        <Run Text="&#xE964;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                        <Run x:Name="RamText" Text="-"/>
                        <Run Text="   "/>
                        <Run x:Name="NetText" Text="–"/>
                    </TextBlock>
                    <Button x:Name="SettingsFolderButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            Content="&#xE713;" ToolTip="Otwórz folder ustawień (tu dodasz własne skrypty)"
                            Click="SettingsFolderButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
